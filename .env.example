# Copy to .env and fill in. Never commit .env.

# CDSE OAuth2 client credentials.
# Create at: https://shapps.dataspace.copernicus.eu/dashboard/ -> User settings -> OAuth clients
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Optional: layer-2 AI scene review. Pick one in config (ai_review.judge_provider).
# The tool is fully functional without any of these keys (layer-1 rules only;
# scenes are then flagged needs_manual_review).
# Gemini (default judge, free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Claude (optional judge): https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: Google Earth Engine (data_provider: gee). Requires a registered
# Google Cloud project; run `earthengine authenticate` once.
GEE_PROJECT=
